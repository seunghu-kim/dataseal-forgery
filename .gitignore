# Whitelist policy: ignore everything at the root, then re-include implementation only.
/*
!/.gitignore
!/LICENSE
!/CMakeLists.txt
!/cmake/
!/include/
!/src/
!/tests/
!/configs/
!/scripts/
!/experiments/

# Never track notes or reports, even inside whitelisted dirs.
*.md
*.pdf
**/docs/
**/reports/
**/results/
**/logs/

# Exception: the collaborator-facing top-level README is tracked.
!/README.md

# Keys, serialized ciphertexts, raw outputs
*.key
*.bin
*.ser
*.ctxt
*.jsonl
*.csv

# Build outputs
build/
build-*/
Build/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
compile_commands.json
Testing/
_deps/
third_party/
external/
vcpkg_installed/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.d
*.gch
*.pch
*.dwo
*.pdb

# Compiled Go command binaries (produced by `go build`/`go run` in the module
# dir); the sources live under experiments/lattigo/cmd/*.
/experiments/lattigo/attackeval
/experiments/lattigo/bench
/experiments/lattigo/finalbench
/experiments/lattigo/finaleval
/experiments/lattigo/parammanifest
/experiments/lattigo/planreport

# Editors / OS / Python
.DS_Store
.vscode/
.idea/
*.swp
*.tmp
*.bak
*.log
.cache/
__pycache__/
*.pyc
.venv/
